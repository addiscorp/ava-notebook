{
  "name": "ava-addon-notebook",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Notebook: an Obsidian-style markdown notebook, as an Ava add-on. `npm run build` writes the add-on's bundle to dist/. Its version is public/manifest.json's, nowhere else.",
  "repository": "https://github.com/addiscorp/ava-notebook",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/comfortaa": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/ext-apps": "2.1.0",
    "markdown-it": "14.3.3"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
